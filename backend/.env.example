# Local development database. Docker supplies PostgreSQL through DATABASE_URL.
DATABASE_URL=sqlite:///./gpgcm_dev.db

# Set this to a unique value of at least 32 characters before starting the API.
SECRET_KEY=

# JSON list of browser origins allowed to call the API. Set production frontend origins here.
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

UPLOAD_DIR=uploads
ACTIVITY_UPLOAD_DIR=private_uploads/activities
PROFILE_UPLOAD_DIR=uploads/profiles
MAX_PROFILE_IMAGE_SIZE_MB=5
MAX_ACTIVITY_ATTACHMENT_SIZE_MB=10
MAX_FILE_SIZE_MB=15

# Resend: create an API key at https://resend.com/api-keys.
RESEND_API_KEY=
# Use a sender/domain verified in Resend for production.
RESEND_FROM_EMAIL=GPGCM College <onboarding@resend.dev>
FRONTEND_BASE_URL=http://localhost:5173
