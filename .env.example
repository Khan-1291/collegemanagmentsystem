# Copy this file to .env. Never commit .env or put real secrets in this file.

# PostgreSQL container credentials. Use a generated URL-safe password for Compose.
POSTGRES_DB=Your University DB name
POSTGRES_USER= DB user
POSTGRES_PASSWORD= Add Strong password here
# DATABASE_URL is composed from these settings for the backend container.
# For a non-Docker backend, set DATABASE_URL directly in backend/.env.

# Generate a unique key, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY= 32-character random string

# Docker publishes the frontend on this host port. Use 80 for default HTTP access.
APP_PORT=80

# The frontend and API share the same origin behind Nginx.
VITE_API_BASE_URL=/api/v1
BACKEND_CORS_ORIGINS=[]
FRONTEND_BASE_URL=http://localhost

# Optional email notifications. For production, use an address on a verified Resend domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=  admin@university.com
